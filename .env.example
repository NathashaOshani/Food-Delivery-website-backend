PORT=4000
IMAGE_STORAGE=local

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/food?appName=Cluster0
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
DELIVERY_FEE=650
GOOGLE_CLIENT_ID=
# Leave blank to accept orders without Stripe Checkout.
STRIPE_SECRET_KEY=
# Stripe Dashboard/CLI signing secret for POST /api/order/webhook.
STRIPE_WEBHOOK_SECRET=
# Automatically expire unpaid Stripe orders after this age and check interval.
UNPAID_ORDER_TTL_MINUTES=60
ORDER_CLEANUP_INTERVAL_MINUTES=15
# Email delivery enables verification for new accounts.
EMAIL_PROVIDER=resend
# For free hosting with HTTPS email: EMAIL_PROVIDER=brevo and a verified EMAIL_FROM.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# For Gmail: set EMAIL_PROVIDER=gmail and EMAIL_FROM=Food <youraddress@gmail.com>.
# Use a Google App Password, not your normal Google password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
